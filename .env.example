# MEDUSA-X Environment Configuration
APP_NAME=MEDUSA-X
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-strong-random-64-char-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Local development defaults to SQLite when PostgreSQL is unavailable;
# For production / Docker / pgvector set DATABASE_URL to PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://medusax:medusax_secret@localhost:5432/medusax
DATABASE_URL=sqlite:///./medusax.db

# CORS & Frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Storage & Limits
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# AI Provider Abstraction
# Supported: deterministic_fallback | openai | anthropic_compatible | openai_compatible
AI_PROVIDER=deterministic_fallback
AI_MODEL=gpt-4o-mini
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Privacy & Safety Controls
ALLOW_EXTERNAL_AI_ON_SYNTHETIC_ONLY=true
ENABLE_OCR=true
TESSERACT_CMD=
